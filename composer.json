{
    "name": "infrangible/m2-table-rate",
    "description": "Lets you view, add, edit and delete the rows of Magento's table rate shipping directly in the admin, instead of exporting and importing CSV files.",
    "type": "magento2-module",
    "version": "1.1.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Shipping",
        "Admin tools",
        "edit table rates in the admin",
        "table rate shipping grid",
        "table rates without CSV"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-table-rate",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~101.0.0|~102.0.0|~103.0.0",
        "infrangible/m2-backend-widget": "~2.7.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\TableRate\\": "src"
        }
    }
}
